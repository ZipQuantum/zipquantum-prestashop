{
  "name": "zipquantum/zipquantum-prestashop",
  "description": "ZipQuantum Smart Links and QR Codes for PrestaShop",
  "type": "prestashop-module",
  "license": "AFL-3.0",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "ZipQuantum\\PrestaShop\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ZipQuantum\\PrestaShop\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "lint": "phpcs",
    "check": [
      "@lint",
      "@analyse",
      "@test"
    ],
    "package": "@php bin/build.php"
  },
  "config": {
    "allow-plugins": {},
    "sort-packages": true
  }
}
